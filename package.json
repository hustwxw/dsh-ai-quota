{
  "name": "@local/dsh-ai-quota",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "AI 额度面板：额度概览、模型限制、调用记录、模型计费与调用分析；侧边栏显示剩余额度百分比，显示名称可配置",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "new-api",
    "quota"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hustwxw/dsh-ai-quota.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/host-test.mjs && node tests/locale-check.cjs && node tests/render-test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
